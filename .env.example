# ============================================================
# CIVA Platform — Environment Variables
# ============================================================
# Copy to .env and fill in your values

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_SESSION_TTL=3600

# ---- TimescaleDB ----
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_USER=civa
TIMESCALEDB_PASSWORD=civa_secret
TIMESCALEDB_DATABASE=civa_behavior

# ---- AWS ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- S3 ----
S3_FORENSIC_BUCKET=civa-forensics
S3_MODEL_BUCKET=civa-models

# ---- SageMaker ----
SAGEMAKER_ENDPOINT_NAME=civa-behavior-model
SAGEMAKER_FALLBACK_ENABLED=true

# ---- PagerDuty ----
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_API_KEY=
PAGERDUTY_ENABLED=false

# ---- MFA Provider ----
MFA_PROVIDER=totp
MFA_TOTP_ISSUER=CIVA-Security
MFA_TOTP_DIGITS=6

# ---- Elastic SIEM ----
ELASTIC_HOST=http://localhost:9200
ELASTIC_API_KEY=
ELASTIC_INDEX_PREFIX=civa-threats

# ---- Splunk ----
SPLUNK_HEC_URL=https://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=civa

# ---- Sentinel SDK ----
SENTINEL_PORT=8001
SENTINEL_LOG_LEVEL=info
SENTINEL_GEOIP_DB_PATH=/data/GeoLite2-City.mmdb

# ---- Behavior Agent ----
BEHAVIOR_AGENT_PORT=8002
BEHAVIOR_MODEL_PATH=./models/isolation_forest.pkl
BEHAVIOR_SCORE_TIMEOUT_MS=15

# ---- Orchestrator ----
ORCHESTRATOR_PORT=8003
ORCHESTRATOR_POLICY_PATH=./config/policy.yaml

# ---- Deception Agent ----
DECEPTION_AGENT_PORT=8004
DECEPTION_SHADOW_PREFIX=/shadow

# ---- Threat Intel ----
THREAT_INTEL_PORT=8005
THREAT_INTEL_SPACY_MODEL=en_core_web_lg

# ---- Monitoring ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# ---- OpenTelemetry ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=civa
