{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "links": [
    {
      "title": "Command Center",
      "url": "/d/civa-command-center",
      "type": "link"
    }
  ],
  "panels": [
    {
      "title": "📊 CIVA Risk Score Distribution — Behavioral Analysis",
      "type": "text",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "options": {
        "content": "# Risk Score Analytics\nReal-time distribution and trends of ML-generated risk scores from the Behavior Agent's Isolation Forest model.",
        "mode": "markdown"
      }
    },
    {
      "title": "Avg Risk Score",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 2 },
      "targets": [
        {
          "expr": "avg(civa_current_risk_score)",
          "legendFormat": "avg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "title": "Sessions > 80 (Kill Zone)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 2 },
      "targets": [
        {
          "expr": "count(civa_current_risk_score > 80)",
          "legendFormat": "critical"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "dark-red", "mode": "fixed" }
        }
      }
    },
    {
      "title": "Sessions 60–80 (Deception)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 2 },
      "targets": [
        {
          "expr": "count(civa_current_risk_score > 60 and civa_current_risk_score <= 80)",
          "legendFormat": "deception"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" }
        }
      }
    },
    {
      "title": "Sessions 30–60 (MFA)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 2 },
      "targets": [
        {
          "expr": "count(civa_current_risk_score > 30 and civa_current_risk_score <= 60)",
          "legendFormat": "mfa"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "yellow", "mode": "fixed" }
        }
      }
    },
    {
      "title": "Sessions 0–30 (Safe)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 2 },
      "targets": [
        {
          "expr": "count(civa_current_risk_score <= 30)",
          "legendFormat": "safe"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" }
        }
      }
    },
    {
      "title": "Model Confidence (F1)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 2 },
      "targets": [
        {
          "expr": "civa_model_confidence_score",
          "legendFormat": "F1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      }
    },
    {
      "title": "Risk Score Distribution (Live Histogram)",
      "description": "Distribution of all scored sessions, bucketed by risk score range. Directly maps to policy tiers: 0-30 Allow, 30-60 MFA, 60-80 Deception, 80-100 Kill.",
      "type": "histogram",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (le) (rate(civa_risk_score_bucket[$__rate_interval]))",
          "legendFormat": "{{le}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 80
          }
        }
      },
      "options": {
        "bucketSize": 10,
        "combine": false
      }
    },
    {
      "title": "Risk Score Trend Over Time",
      "description": "Shows the ratio of sessions in each policy tier over time.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(civa_risk_score_bucket{le=\"30\"}[$__rate_interval]))",
          "legendFormat": "✅ Safe (0–30)"
        },
        {
          "expr": "sum(rate(civa_risk_score_bucket{le=\"60\"}[$__rate_interval])) - sum(rate(civa_risk_score_bucket{le=\"30\"}[$__rate_interval]))",
          "legendFormat": "🔐 MFA (30–60)"
        },
        {
          "expr": "sum(rate(civa_risk_score_bucket{le=\"80\"}[$__rate_interval])) - sum(rate(civa_risk_score_bucket{le=\"60\"}[$__rate_interval]))",
          "legendFormat": "🎭 Deception (60–80)"
        },
        {
          "expr": "sum(rate(civa_risk_score_bucket{le=\"100\"}[$__rate_interval])) - sum(rate(civa_risk_score_bucket{le=\"80\"}[$__rate_interval]))",
          "legendFormat": "💀 Kill (80–100)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30,
            "gradientMode": "scheme",
            "stacking": { "mode": "percent" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "✅ Safe (0–30)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#37872D" } }]
          },
          {
            "matcher": { "id": "byName", "options": "🔐 MFA (30–60)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#E0B400" } }]
          },
          {
            "matcher": { "id": "byName", "options": "🎭 Deception (60–80)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830" } }]
          },
          {
            "matcher": { "id": "byName", "options": "💀 Kill (80–100)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#C4162A" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] }
      }
    },
    {
      "title": "Anomaly Score Distribution (Isolation Forest Raw Scores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(civa_ml_anomaly_score_bucket[5m]))",
          "legendFormat": "p50 anomaly"
        },
        {
          "expr": "histogram_quantile(0.90, rate(civa_ml_anomaly_score_bucket[5m]))",
          "legendFormat": "p90 anomaly"
        },
        {
          "expr": "histogram_quantile(0.99, rate(civa_ml_anomaly_score_bucket[5m]))",
          "legendFormat": "p99 anomaly"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "scheme"
          }
        }
      }
    },
    {
      "title": "Feature Contribution Heatmap",
      "description": "Shows which behavioral features contribute most to high risk scores (top anomalous sessions).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "avg(civa_feature_importance{feature=\"req_per_min\"})",
          "legendFormat": "req_per_min"
        },
        {
          "expr": "avg(civa_feature_importance{feature=\"burst_ratio\"})",
          "legendFormat": "burst_ratio"
        },
        {
          "expr": "avg(civa_feature_importance{feature=\"is_headless\"})",
          "legendFormat": "is_headless"
        },
        {
          "expr": "avg(civa_feature_importance{feature=\"geo_distance\"})",
          "legendFormat": "geo_distance"
        },
        {
          "expr": "avg(civa_feature_importance{feature=\"endpoint_diversity\"})",
          "legendFormat": "endpoint_diversity"
        },
        {
          "expr": "avg(civa_feature_importance{feature=\"sensitive_freq\"})",
          "legendFormat": "sensitive_freq"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": { "mode": "normal" }
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Risk Score by User (Top 25 Riskiest)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "topk(25, max by (user_id) (civa_current_risk_score))",
          "legendFormat": "{{user_id}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Risk Score" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 30 },
                { "color": "orange", "value": 60 },
                { "color": "red", "value": 80 }
              ]}}
            ]
          }
        ]
      }
    },
    {
      "title": "Attack Type Distribution (24h)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum by (attack_type) (increase(civa_threat_detection_total[24h]))",
          "legendFormat": "{{attack_type}}"
        }
      ],
      "options": {
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right" }
      }
    },
    {
      "title": "Model Version & Health",
      "type": "table",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 24 },
      "targets": [
        {
          "expr": "civa_model_info",
          "legendFormat": "{{version}}",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["civa", "security", "risk-scores", "ml"],
  "templating": {
    "list": [
      {
        "name": "user_id",
        "type": "query",
        "query": "label_values(civa_current_risk_score, user_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "interval",
        "type": "interval",
        "query": "1m,5m,15m,30m,1h",
        "current": { "text": "5m", "value": "5m" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "CIVA Risk Distribution",
  "uid": "civa-risk-distribution",
  "version": 1
}
